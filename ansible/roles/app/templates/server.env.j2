{{ ansible_managed | comment }}
# Rendered by Ansible from roles/app/templates/server.env.j2.
# Edit the variables in ansible/group_vars/all/, not this file — the next
# deploy overwrites it.

NODE_ENV={{ node_env }}
PORT={{ backend_port }}
# Loopback only: Nginx is the sole public listener. Binding 0.0.0.0 here would
# expose the API on {{ backend_port }} to anyone who finds a firewall gap.
HOST={{ backend_host }}
API_PREFIX={{ api_prefix }}

# ---- Database --------------------------------------------------------------
DATABASE_URL=postgresql://{{ db_user }}:{{ vault_db_password | urlencode }}@{{ db_host }}:{{ db_port }}/{{ db_name }}?schema=public

# ---- Auth ------------------------------------------------------------------
JWT_SECRET={{ vault_jwt_secret }}
JWT_ACCESS_EXPIRES_IN={{ jwt_access_expires_in | default('24h') }}
JWT_REFRESH_EXPIRES_IN={{ jwt_refresh_expires_in | default('7d') }}

# ---- CORS ------------------------------------------------------------------
# Real origins, comma-separated. "*" would reflect any origin and therefore
# disable credentialed CORS entirely — never use it in production.
CORS_ORIGIN={{ site_url }}{% if domain_alias %},{{ site_scheme }}://{{ domain_alias }}{% endif %}


# ---- Rate limiting ---------------------------------------------------------
# NOTE: these counters live in each Node process's memory. With
# pm2_instances={{ pm2_instances }} the real ceiling is roughly
# {{ rate_limit_max }} x {{ pm2_instances }} per IP per window.
RATE_LIMIT_MAX={{ rate_limit_max }}
RATE_LIMIT_WINDOW={{ rate_limit_window }}
AUTH_RATE_LIMIT_MAX={{ auth_rate_limit_max }}
AUTH_RATE_LIMIT_WINDOW={{ auth_rate_limit_window }}

# ---- Public URL and uploads -------------------------------------------------
APP_URL={{ site_url }}
UPLOAD_DIR={{ upload_dir }}
PUBLIC_UPLOAD_PATH={{ public_upload_path }}
MAX_FILE_SIZE={{ max_file_size }}

# ---- Payment gateway (SANDBOX / PLACEHOLDER) --------------------------------
# ZARINPAL_SANDBOX=true keeps every payment on ZarinPal's sandbox host. No real
# money moves. To go live: set zarinpal_sandbox: "false" in group_vars and put
# the real merchant id in vault as vault_zarinpal_merchant_id.
{% if payment_gateway == 'zibal' %}
ZIBAL_MERCHANT_ID={{ vault_zibal_merchant_id | default(zibal_merchant_id) }}
ZIBAL_CALLBACK_URL={{ site_url }}{{ api_prefix }}/payments/verify/zibal
{% else %}
ZARINPAL_MERCHANT_ID={{ vault_zarinpal_merchant_id | default('') or zarinpal_merchant_id }}
ZARINPAL_SANDBOX={{ zarinpal_sandbox }}
ZARINPAL_CALLBACK_URL={{ site_url }}{{ api_prefix }}/payments/verify/zarinpal
{% endif %}

# ---- SMS (PLACEHOLDER) ------------------------------------------------------
# Both blank: password-reset codes are written to the server log instead of
# being sent. Fill exactly one once the customer has a provider line.
KAVENEGAR_API_KEY={{ vault_kavenegar_api_key | default(kavenegar_api_key) }}
SMS_IR_API_KEY={{ vault_sms_ir_api_key | default(sms_ir_api_key) }}
SMS_SENDER_NUMBER={{ sms_sender_number }}

# ---- First admin account ----------------------------------------------------
# Seeded on boot only if the phone number is not already taken. Change the
# password from the admin UI after the first login.
ADMIN_SEED_EMAIL={{ vault_admin_seed_email }}
ADMIN_SEED_PHONE={{ vault_admin_seed_phone }}
ADMIN_SEED_PASSWORD={{ vault_admin_seed_password }}
