// {{ ansible_managed }}
// Rendered by Ansible from roles/app/templates/ecosystem.config.cjs.j2.
//
// `cwd` points at the `current` symlink rather than a release directory, so
// `pm2 reload` after a rollback picks up whatever `current` points to now
// without the process list needing to be rewritten.
module.exports = {
  apps: [
    {
      name: '{{ pm2_app_name }}',
      script: 'dist/index.js',
      cwd: '{{ app_root }}/current/Jolfa-Server',
      // Cluster mode: {{ pm2_instances }} workers behind PM2's own load
      // balancer. The API keeps no per-process state a request depends on
      // (JWT auth, Prisma pool, no in-memory sessions) — with the one
      // exception of the rate-limit counters, which are per worker.
      exec_mode: 'cluster',
      instances: {{ pm2_instances }},
      // The app reads .env itself via dotenv; NODE_ENV is set here so it is
      // correct even before dotenv runs.
      env: {
        NODE_ENV: '{{ node_env }}',
      },
      max_memory_restart: '{{ pm2_max_memory_restart | default("400M") }}',
      // Give the drain in src/index.ts room to finish in-flight requests
      // before PM2 escalates to SIGKILL. The app's own backstop is 10s.
      kill_timeout: 12000,
      // Wait for the process to actually come up before considering the
      // reload successful, instead of declaring victory on spawn.
      wait_ready: false,
      listen_timeout: 10000,
      output: '/var/log/jolfa/out.log',
      error: '/var/log/jolfa/error.log',
      merge_logs: true,
      time: true,
    },
  ],
};
