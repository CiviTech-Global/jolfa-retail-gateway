# Copy to .env.test before running `npm test`.
# The suite runs against a REAL Postgres database that it truncates between
# tests — point DATABASE_URL at a throwaway database, never at your dev one.
#
#   createdb jolfa_test
#   cp .env.test.example .env.test   # then set the password below
#   npm test
NODE_ENV=test
PORT=3001
HOST=0.0.0.0
API_PREFIX=/api/v1
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/jolfa_test?schema=public
JWT_SECRET=test-secret-at-least-16-characters-long
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=*
APP_URL=http://localhost:3001
UPLOAD_DIR=uploads-test
PUBLIC_UPLOAD_PATH=/uploads
MAX_FILE_SIZE=5242880
ZARINPAL_SANDBOX=true
ADMIN_SEED_PASSWORD=admin123
