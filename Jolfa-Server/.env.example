# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jolfa_retail_gateway?schema=public

# JWT
JWT_SECRET=change-me-in-production-min-32-characters
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
# Setting this to "*" reflects any origin and therefore disables credentialed
# CORS — reflecting any origin *with* credentials would let any site read
# authenticated responses. List real origins here, comma-separated.
CORS_ORIGIN=http://localhost:5173

# Rate limiting
# The global bucket is per-IP across every route; the auth bucket additionally
# covers login, register, change-password, forgot-password and reset-password.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=15 minutes

# Public base URL of this server (used to build absolute asset URLs, e.g. demo data images)
APP_URL=http://localhost:3001

# File uploads
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_PATH=/uploads
MAX_FILE_SIZE=5242880

# Payment gateways (sandbox keys for development)
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:3001/api/v1/payments/verify/zarinpal

ZIBAL_MERCHANT_ID=xxxxxxxxxxxx
ZIBAL_CALLBACK_URL=http://localhost:3001/api/v1/payments/verify/zibal

# Seed
# Both accounts share one login form and are routed by role: ADMIN lands on
# /admin, CUSTOMER on /profile. The two phone numbers MUST differ — a collision
# makes the seeder skip the customer, leaving no account to test the customer
# dashboard with.
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PHONE=09120000000
ADMIN_SEED_PASSWORD=change-me-after-first-login

USER_SEED_EMAIL=user@example.com
USER_SEED_PHONE=09121111111
USER_SEED_PASSWORD=change-me-after-first-login

# SMS — SMS.ir (https://sms.ir), the only provider wired in.
#
# Leave SMS_IR_API_KEY blank to run without a provider: every notification is
# recorded in the SMS log with status PENDING instead of being sent, and the
# password-reset code is returned as devCode so the flow stays testable locally.
SMS_IR_API_KEY=
# The id of the OTP template registered in the SMS.ir panel. One-time codes go
# through this template on a service line, which is why they reach customers
# who have blocked advertising SMS. Seeded into the database on first boot; the
# admin panel owns it afterwards.
SMS_IR_OTP_TEMPLATE_ID=
# The shop's own line number, e.g. 30002100. Needed ONLY for the free-text
# notifications (order placed, paid, shipped...). Without it those are recorded
# as FAILED with the reason shown in the admin panel; OTP is unaffected.
SMS_SENDER_NUMBER=
