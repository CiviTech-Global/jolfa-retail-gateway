# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
API_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/jolfa_retail_gateway?schema=public

# JWT
JWT_SECRET=change-me-in-production-min-32-characters
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# Public base URL of this server (used to build absolute asset URLs, e.g. demo data images)
APP_URL=http://localhost:3001

# File uploads
UPLOAD_DIR=uploads
PUBLIC_UPLOAD_PATH=/uploads
MAX_FILE_SIZE=5242880

# Payment gateways (sandbox keys for development)
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:3001/api/v1/payments/verify/zarinpal

ZIBAL_MERCHANT_ID=xxxxxxxxxxxx
ZIBAL_CALLBACK_URL=http://localhost:3001/api/v1/payments/verify/zibal

# Seed
ADMIN_SEED_PASSWORD=change-me-after-first-login

# SMS provider — used to deliver password-reset codes.
# Leave BOTH keys blank to run without a provider: the reset code is written to
# the server log (and returned as devCode in the API response) instead of being
# sent, so the forgot-password flow is testable locally. Fill ONE for real delivery.
#
# Kavenegar: https://panel.kavenegar.com  (API key from the panel)
KAVENEGAR_API_KEY=
# SMS.ir: https://sms.ir  (API key from the developer panel)
SMS_IR_API_KEY=
# Sender line number registered with your provider, e.g. 30002100
SMS_SENDER_NUMBER=
