# Base URL of the API, including the /api/v1 prefix.
#
# Vite inlines this at BUILD time, not at runtime — the value present when
# `npm run build` runs is compiled into the JavaScript bundle and shipped to
# every visitor. Changing it later requires a rebuild; restarting the server
# does nothing.
#
# There is a fallback in src/api/client.ts and src/lib/utils.ts, but it points
# at localhost. A production build made without this variable therefore builds
# successfully and then fails in every visitor's browser, because their machine
# is not running the API. Set it before building.
#
# Local development — the Vite dev server on 5173 calling the API on 3001:
VITE_API_BASE_URL=http://localhost:3001/api/v1

# Production — copy this file to .env.production on the server and use the
# public HTTPS origin, which Nginx proxies through to Node:
#   VITE_API_BASE_URL=https://your-domain.ir/api/v1
